# Solana PayAI Environment Variables

# API Configuration
VITE_API_URL=https://api.solanapayai.com
VITE_API_VERSION=v1

# Solana Configuration
VITE_SOLANA_NETWORK=mainnet-beta
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# OpenAI Configuration
VITE_OPENAI_API_KEY=your_openai_api_key

# Authentication
VITE_AUTH_DOMAIN=your_auth_domain
VITE_AUTH_CLIENT_ID=your_auth_client_id

# Feature Flags
VITE_ENABLE_ADVANCED_FRAUD_DETECTION=true
VITE_ENABLE_FEE_OPTIMIZATION=true
VITE_ENABLE_AUTOMATED_PAYOUTS=true

# Analytics
VITE_ANALYTICS_ID=your_analytics_id

